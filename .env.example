# Bắt buộc cho cấu hình API Key của nhà cung cấp (Provider) để chạy model thực tế
# Tên model khai báo trong source code các Agent: gemini-flash-lite-latest (<= 10B - Flash-Lite Lightweight Agent Model)

# 1. Cấu hình cho Google Gemini API / Google AI Studio (Hỗ trợ chính thức gemini-flash-lite-latest)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Hoặc Cấu hình cho chuẩn OpenAI-Compatible (Ollama, vLLM, OpenRouter, Groq)
# OPENAI_API_KEY=your_api_key_here
# OPENAI_BASE_URL=http://localhost:11434/v1
